.col-6
  - url = @match_decision_reason.persisted? ? admin_match_decision_reason_path(@match_decision_reason) : admin_match_decision_reasons_path
  = simple_form_for @match_decision_reason, as: :match_decision_reason, url: url do |f|
    = f.error_notification
    .form-inputs
      = f.input :name
      = f.input :referral_result, as: :select, collection: { 'None' => nil, 'Client Rejected' => MatchDecisionReasons::Base::CLIENT_REJECTED, 'Provider Rejected' => MatchDecisionReasons::Base::PROVIDER_REJECTED }, include_blank: false
      = f.input :active

    .form_actions.text-right
      = link_to 'Cancel', admin_match_decision_reasons_path, class: 'btn btn-secondary'
      = f.button :submit, class: 'btn btn-primary'
