- kinds = local_assigns.fetch(:kinds, %w[decline cancel])
.row
  - kinds.each do |kind|
    - show_audience = kind == 'decline' && @step.supports_multiple_actors?
    .col-lg-6
      .c-card.mb-4
        .c-card__header
          %h3= "#{kind.titleize} Reasons"
        .c-card__content.p-0
          .table-responsive
            %table.table.table-striped.mb-0
              %thead
                %tr
                  %th Include
                  %th Reason
                  %th Position
                  %th Requires Explanation
                  %th Referral Result
                  - if show_audience
                    %th Audience
              %tbody
                - rows[kind.to_sym].each do |row|
                  %tr
                    %td
                      = hidden_field_tag "assignments[#{kind}][#{row.reason.id}][selected]", '0'
                      = check_box_tag "assignments[#{kind}][#{row.reason.id}][selected]", '1', row.assignment.present?
                    %td= row.reason.name
                    %td= number_field_tag "assignments[#{kind}][#{row.reason.id}][position]", row.assignment&.position || 0, style: 'width: 5em'
                    %td= check_box_tag "assignments[#{kind}][#{row.reason.id}][requires_explanation]", '1', row.assignment&.requires_explanation || false
                    %td
                      = select_tag "assignments[#{kind}][#{row.reason.id}][referral_result]", options_for_select({ 'Inherit default' => '', 'Client Rejected' => MatchDecisionReasons::Base::CLIENT_REJECTED, 'Provider Rejected' => MatchDecisionReasons::Base::PROVIDER_REJECTED }, row.assignment&.referral_result)
                      - if row.reason.referral_result.present?
                        %br
                        %em.text-muted.font-size-small= "Default: #{row.reason.referral_result_text}"
                    - if show_audience
                      %td
                        = select_tag "assignments[#{kind}][#{row.reason.id}][audience]", options_for_select([['Everyone', '']] + @route.visible_contact_types.map { |contact_type| [@route.contact_label_for(contact_type), contact_type] }, row.assignment&.audience)
