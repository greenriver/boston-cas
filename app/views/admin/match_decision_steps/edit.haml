- title = "#{@route.title}: #{@step.display_name}"
- content_for :title, title
= content_for :crumbs do
  = link_to '« Back to Route', edit_admin_match_route_path(@route)

%h1= content_for :title

= form_tag admin_match_route_match_decision_step_path(@route, @step), method: :patch do
  .c-card.mb-4
    .c-card__header
      %h3 Default Referral Result
    .c-card__content
      = select_tag 'match_decision_step[default_referral_result]', options_for_select({ 'None' => nil, 'Client Rejected' => MatchDecisionReasons::Base::CLIENT_REJECTED, 'Provider Rejected' => MatchDecisionReasons::Base::PROVIDER_REJECTED }, @step.default_referral_result)

  %p.text-muted
    Choose which reasons apply to this step.
  = render 'admin/match_decision_steps/reason_tables', rows: @rows, kinds: (@step.supports_declines? ? %w[decline cancel] : %w[cancel])
  .text-right
    = submit_tag 'Save Step Reasons', class: 'btn btn-primary'
