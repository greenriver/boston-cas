- title = "Match Routes"
- content_for :title, title

= render 'menus/admin_tabs'

%h1= content_for :title

%h2 Settings

%ul.nav.nav-tabs{role: 'tablist'}
  %li.nav-item{role: 'presentation'}
    %a.nav-link.active{id: 'active-routes-tab', data: { bs_toggle: 'tab' }, href: '#active-routes', role: 'tab', aria: { controls: 'active-routes', selected: 'true' }}
      Active Routes
      %span.badge.bg-secondary.ms-1= @active_routes.size
  %li.nav-item{role: 'presentation'}
    %a.nav-link{id: 'inactive-routes-tab', data: { bs_toggle: 'tab' }, href: '#inactive-routes', role: 'tab', aria: { controls: 'inactive-routes', selected: 'false' }}
      Inactive Routes
      %span.badge.bg-secondary.ms-1= @inactive_routes.size

.tab-content.mb-6
  .tab-pane.fade.show.active{id: 'active-routes', role: 'tabpanel', aria: { labelledby: 'active-routes-tab' }}
    .p-3
      = render 'route_table', routes: @active_routes
  .tab-pane.fade{id: 'inactive-routes', role: 'tabpanel', aria: { labelledby: 'inactive-routes-tab' }}
    .p-3
      = render 'route_table', routes: @inactive_routes


%h2 Notifications

%ul.nav.nav-tabs{role: 'tablist'}
  - @routes.each_with_index do |route, index|
    %li.nav-item{role: 'presentation'}
      %a.nav-link{class: ('active' if index.zero?), id: "route-#{route.id}-tab", data: { bs_toggle: 'tab'}, href: "#route-#{route.id}", role: 'tab', aria: {controls: "route-#{route.id}", selected: index.zero?}}
        = route.title

.tab-content
  - @routes.each_with_index do |route, index|
    .tab-pane.fade{class: ('show active' if index.zero?), id: "route-#{route.id}", role: 'tabpanel', aria: {labelledby: "route-#{route.id}-tab"}}
      .p-3
        = render 'notifications', route: route
