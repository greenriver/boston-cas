- title = "#{@route.title}: Decline & Cancel Reasons"
- content_for :title, title

= render 'menus/admin_tabs'

%h1= content_for :title
%p= link_to '« Back to Route', edit_admin_match_route_path(@route)

= form_tag admin_match_route_route_reason_assignment_path(@route), method: :patch do
  %p.text-muted
    These are the default reasons available on every step of this route. Add a step-specific override below to customize an individual step.
  = render 'admin/match_decision_steps/reason_tables', rows: @rows
  = submit_tag 'Save Route Defaults', class: 'btn btn-primary'

%h2 Steps
.table-responsive
  %table.table.table-striped
    %thead
      %tr
        %th Step
        %th Default Rejection Type
        %th
    %tbody
      - @steps.each do |step|
        %tr
          %td= step.decision_type.demodulize.titleize
          %td
            - if step.default_referral_result == MatchDecisionReasons::Base::CLIENT_REJECTED
              Client Rejected
            - elsif step.default_referral_result == MatchDecisionReasons::Base::PROVIDER_REJECTED
              Provider Rejected
            - else
              &mdash;
          %td= link_to 'Customize this step', edit_admin_match_route_match_decision_step_path(@route, step), class: 'btn btn-sm btn-secondary'
