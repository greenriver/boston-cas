= render 'breadcrumbs'

%h1
  Upload Complete

- problems = @upload.clients.reduce(0){ |sum, client| sum += client.errors.count }

%ul.list-unstyled
  %li= "#{@upload.added} new clients added"
  %li= "#{@upload.touched} existing clients updated"
  %li= "#{problems} records with problems"
  - if @upload.skipped_identifiers.present?
    %li= "#{@upload.skipped_identifiers.size} clients skipped — their ID is already registered to another agency"
    %ul
      - @upload.skipped_identifiers.each do |identifier|
        %li= identifier

- if problems > 0
  %p.text-muted
    The rows below were skipped, so nothing changed for these clients, including their
    availability. Correct the values and upload again.
  .row
  .col-sm-12
    .table-responsive
      %table.table.table-condensed
        %thead
          %th Client
          %th Item
          %th Problem
        %tbody
          - @upload.clients.each do |client|
            - client.errors.each_with_index do |error, index|
              %tr
                - if index == 0
                  %td= "#{client.client_identifier}"
                - else
                  %td
                %td= error.attribute.to_s.humanize
                %td= error.full_message
.row
  = link_to 'Return to Clients', deidentified_clients_path, class: 'btn btn-sm btn-primary'
