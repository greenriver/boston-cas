-# Partial: used polymorphically for building and unit attributes/amenities
-#   Arguments:
-#     housingable: currently a building or unit object
-#     attribute: a HousingAttribute object

- if @attribute.include_value?
  = content_for :modal_title do
    Add Attribute

  = simple_form_for @attribute, url: polymorphic_path([@housingable, :housing_attributes]) do |f|
    = f.hidden_field :include_value, value: true
    = f.input :name, collection: HousingAttribute.existing_attributes, as: :select_2, input_html: { class: :jType, data: { tags: true }}, include_blank: true, hint: 'If you don\'t see the type required, type it in and select it', placeholder: 'Please choose'
    = f.input :value, collection: [], as: :select_2, input_html: { class: :jValue, data: { tags: true, 'collection-path' => polymorphic_path([:values, @housingable, :housing_attributes]) } }, include_blank: true, hint: 'If you don\'t see the value required, type it in and select it', placeholder: 'Please choose'
    = f.button :submit

  = content_for :page_js do
    :javascript
      $(document).ready(function() {
        $('.jType').on('change', function(e) {
          var attribute_name = $(this).val();
          var input = $('.jValue');
          [path, query] = input.data('collection-path').split('?');
          input.data('collection-path', path + "?attribute_name=" + attribute_name);
          App.remoteSelectLoad.init();
        });
      });

- else
  = content_for :modal_title do
    Add Amenity

  = simple_form_for @attribute, url: polymorphic_path([@housingable, :housing_attributes]) do |f|
    = f.hidden_field :include_value, value: false
    = f.input :name, collection: HousingAttribute.existing_amenities, as: :select_2, input_html: { data: { tags: true } }, include_blank: true, hint: 'If you don\'t see the amenity required, type it in and select it', placeholder: 'Please choose'
    = f.button :submit
