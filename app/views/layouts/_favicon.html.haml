- if Theme.favicon_32.attached?
  %link{rel: 'icon', type: 'image/png', sizes: '32x32', href: theme_assets_favicon_32_path}
- else
  = favicon_link_tag 'favicon-32x32.png', sizes: '32x32', rel: 'icon', type: 'image/png'

- if Theme.favicon_16.attached?
  %link{rel: 'icon', type: 'image/png', sizes: '16x16', href: theme_assets_favicon_16_path}
- else
  = favicon_link_tag 'favicon-16x16.png', sizes: '16x16', rel: 'icon', type: 'image/png'

- if Theme.favicon_ico.attached?
  %link{rel: 'shortcut icon', href: theme_assets_favicon_ico_path}
  %link{rel: 'icon', href: theme_assets_favicon_ico_path}
- else
  = favicon_link_tag 'favicon.ico', rel: 'shortcut'
  = favicon_link_tag 'favicon.ico', rel: 'icon'
