= content_for :page_js do
  :javascript
    // Force agreement with terms
    (function() {
      var modalEl = document.getElementById('shelter-agency-modal');
      if (!modalEl || !window.bootstrap) return;

      var hideModal = function() {
        window.bootstrap.Modal.getInstance(modalEl)?.hide();
      };

      window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();

      $('.jCancel').on('click', hideModal);
      $('#shelter-agency-modal .jAccept').on('click', hideModal);
      $('.jNeedsToAgree').on('click', function(e) {
        e.preventDefault();
      });
    })();

#shelter-agency-modal.modal.fade(role="dialog")
  .modal-dialog(role="document")
    .modal-content(data-modal-container)
      .modal-header
        %h4.modal-title(data-modal-title)
          Confirm and Agree
        %button.btn-close.pull-right.jCancel(aria-label="Close" type="button")
      .modal-body.clearfix
        %p
          = simple_format Translation.translate('match shelter agency agreement modal')
        %p
          If any of the steps above still need to be completed, please click "Cancel".
      .modal-footer(data-modal-footer)
        %button.btn.btn-secondary.pull-right.jCancel(aria-label="Close" pjax-modal-close type="button")
          Cancel
        %button.btn.btn-primary.jAccept{type: 'submit'}
          Accept
