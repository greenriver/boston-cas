%tr.history-row{data: event.history_row_metadata}
  %td.history--date= event.timestamp.try(:strftime, '%m/%d/%Y')
  %td.history--event-name
    = event.name
    - if event.show_note?(current_contact)
      .history--event-note
        %strong Note:
        = event.note
        - if event.note_editable_by? current_contact
          .history--event-note--actions
            = link_to edit_match_note_path(match, event.event, match_note_referrer_params), data: {loads_in_pjax_modal: true} do
              %span.icon-pencil
              Edit Note
  %td= event.decision&.step_name
  %td.history--contact-name
    - tooltip_title = event.contact_names.map { |n| h(n) }.join("<br>").html_safe if event.grouped
    - if tooltip_title.present?
      %span.history--contacts-tooltip{data: {bs_toggle: "tooltip", bs_placement: "top", bs_html: "true", bs_title: tooltip_title}}= event.contact_display
    - else
      = event.contact_display
