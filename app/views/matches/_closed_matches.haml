- matches = @client.closed_matches_for_display - [match]
- if can_reject_matches? && matches.count.positive?
  %h3.detail-box--label
    Closed Matches
  %table.table.table-striped
    %thead
      %tr
        %th Date
        %th Route
        %th Status
        %th Reason
    %tbody
      - matches.each do |closed_match|
        - decision = closed_match.initialized_decisions.last
        %tr
          %td= link_to decision.updated_at.strftime('%m/%d/%Y'), match_path(closed_match)
          %td= closed_match.match_route.title
          %td= match.overall_status[:name]
          %td= decision.label
