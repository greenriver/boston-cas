%ul.nav.nav-tabs
  -if can_enter_deidentified_clients?
    %li.nav-item{role: "presentation", class: ('active' if current_page?(deidentified_clients_path) || controller_name == 'deidentified_client_search_queries')}
      = link_to 'Deidentified Clients', deidentified_clients_path, class: 'nav-link'
  -if can_enter_identified_clients?
    %li.nav-item{role: "presentation", class: ('active' if current_page?(identified_clients_path) || controller_name == 'identified_client_search_queries')}
      = link_to 'Identified Clients', identified_clients_path, class: 'nav-link'
  -if can_manage_imported_clients?
    %li.nav-item{role: "presentation", class: ('active' if current_page?(imported_clients_path) || controller_name == 'imported_client_search_queries')}
      = link_to 'Imported Clients', imported_clients_path, class: 'nav-link'