%ul.nav.nav-tabs
  -if can_enter_deidentified_clients?
    %li.nav-item{role: "presentation", class: ('active' if controller_name == 'deidentified_clients')}
      = link_to 'Deidentified Clients', deidentified_clients_path, class: 'nav-link'
  -if can_enter_identified_clients?
    %li.nav-item{role: "presentation", class: ('active' if controller_name == 'identified_clients')}
      = link_to 'Identified Clients', identified_clients_path, class: 'nav-link'
  -if can_manage_imported_clients?
    %li.nav-item{role: "presentation", class: ('active' if controller_name == 'imported_clients')}
      = link_to 'Imported Clients', imported_clients_path, class: 'nav-link'
