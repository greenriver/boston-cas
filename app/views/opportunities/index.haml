.o-page__title
  %h1= t '.title'
  - if can_add_vacancies?
    .o-page__action.o-page__action--stacked
      = link_to new_opportunity_path, class: 'btn btn-primary margin-bottom-02' do
        %span.icon-plus
        Submit a Vacancy
      %a.how-to-popover{'data-bs-toggle': "popover", 'data-bs-placement': "bottom", 'data-bs-content': "<ol><li>Find the #{Building.model_name.human} & edit units available</li><li>Find program and make a voucher available</li></ol>", role: 'button', 'tabindex': 0,'data-bs-html': "true", 'data-bs-trigger': "focus"}
        %span.icon-info
        How to Add a Vacancy

- @prompt = t '.search_prompt'
.row.o-search
  .col-sm-4.o-search__field-wrapper
    = render 'search_form', method: :get
  .col-sm-6.sort-filter.o-search__actions
    = render 'filter'

= render 'tabs'
= render 'table'
