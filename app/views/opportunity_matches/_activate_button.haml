- if client.client_opportunity_matches.active.on_route(@opportunity.match_route).exists?
  - match_warning = "Activating this match will cancel all other active matches for #{@exporter.client_name(client)} on the #{@opportunity.match_route.title}."
- else
  - match_warning = ''
- active_client = @opportunity.active_matches.first&.client
- if active_client.present?
  - text = 'Activate Match Canceling Current'
  - if match_warning.present?
    - match_warning += " In addition, it will cancel the current match involving #{@exporter.client_name(active_client)}."
  - else
    - match_warning = "Activating this match will cancel the current match involving #{@exporter.client_name(active_client)}."
- else
  - text = 'Activate Match'

%td.text-center= link_to text, opportunity_match_path(@opportunity, client), class: 'btn btn-light mb-2', method: :patch, data: {confirm: match_warning}