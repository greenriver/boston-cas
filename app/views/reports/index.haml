- content_for :title, Translation.translate("CAS Reports")
%h1= content_for :title

%ul.nav.nav-tabs{role: :tablist}
  - @report_definitions.each_with_index do |(group_name, reports), index|
    %li.nav-item{role: :presentation}
      %a{href: "##{group_name.parameterize.dasherize}", role: :tab, data: { bs_toggle: :tab}, aria: {controls: "#{group_name}"}, class: 'nav-link'}
        #{group_name}

.tab-content#reports-tab-content
  - @report_definitions.each_with_index do |(group_name, reports), index|
    - dashed_group_name = group_name.parameterize.dasherize
    %div{role: :tabpanel, class: 'tab-pane', id: dashed_group_name}
      %h3
        #{group_name}
      %div.o-card-grid{class: "warehouse-reports__#{dashed_group_name}"}
        - reports.each do |report|
          - if report
            %article.c-card.c-card--padded.c-card--flex
              = link_to report.url, class: 'c-card__content' do
                .c-card__title
                  - unless report.limitable?
                    %i.icon-notification{data: { bs_toggle: :tooltip, title: 'Report is not limited by agency.'}}
                  = report.name
                .c-card__description= report.description.html_safe


= content_for :page_js do
  :javascript
    (function() {
      var hash = window.location.hash;
      var tabToShow = hash
        ? document.querySelector('.nav-tabs a[href="' + hash + '"]')
        : document.querySelector('ul.nav-tabs li:first-child a');
      if (tabToShow) { new bootstrap.Tab(tabToShow).show(); }

      document.querySelectorAll('ul.nav-tabs a').forEach(function(el) {
        el.addEventListener('shown.bs.tab', function(e) {
          var href = e.target.getAttribute('href');
          if (href) { history.pushState({}, '', href); }
        });
      });
    })();
