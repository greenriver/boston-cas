- help_text = local_assigns.fetch(:help_text, '')
- hide_inherited = local_assigns.fetch(:hide_inherited, false)
- on_unit = local_assigns.fetch(:on_unit, false)
- section_header = local_assigns.fetch(:section_header, 'Rules')
- all_rules = Rule.order(:name).to_a
- all_rules_by_id = all_rules.index_by(&:id)
- requirements = form.object.requirements.reject(&:marked_for_destruction?).sort_by { |r| r.created_at || Time.current }
- base_name = form.object_name

.row
  .col-lg-12
    .c-card.c-card--flush
      %h3= section_header
      .c-card__content
        - if help_text.present?
          %p.margin-bottom-02= help_text
        - unless hide_inherited
          .mb-6= render 'requirement_manager/inherited_rules', inheritee: form.object
        - if can_assign_requirements?
          %fieldset{data: { controller: 'requirements' }}
            %div{data: { 'requirements-target': 'list' }}
              - requirements.each_with_index do |req, req_i|
                - rule = all_rules_by_id[req.rule_id]
                - next unless rule
                - rule_name = on_unit ? (rule.alternate_name.presence || rule.name_with_verb) : rule.name_with_verb
                .mb-2{data: { 'req-entry': '' }}
                  %input{type: 'hidden', name: "#{base_name}[requirements_attributes][#{req_i}][id]", value: req.id}
                  %input{type: 'hidden', name: "#{base_name}[requirements_attributes][#{req_i}][_destroy]", value: '0', data: { 'req-destroy': '' }}
                  .d-flex.gap-2.align-items-center
                    %select.form-select.w-auto.flex-shrink-0{ name: "#{base_name}[requirements_attributes][#{req_i}][positive]" }
                      %option{value: 'true', selected: req.positive} Must
                      %option{value: 'false', selected: !req.positive} Can't
                    %select.form-select.select2.flex-grow-1{ name: "#{base_name}[requirements_attributes][#{req_i}][rule_id]", data: { 'req-rule-select': '' } }
                      %option{value: ''} Select rule...
                      - all_rules.each do |rule_opt|
                        - rule_opt_name = on_unit ? (rule_opt.alternate_name.presence || rule_opt.name_with_verb) : rule_opt.name_with_verb
                        %option{value: rule_opt.id, selected: rule_opt.id == req.rule_id, data: { variable: rule_opt.variable_requirement?.to_s, 'variable-type': rule_opt.variable_input_type.to_s, 'variable-options': rule_opt.variable_options.to_json, 'variable-label': rule_opt.variable_label.to_s }}= rule_opt_name
                    %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'requirements#removeReq' }} Remove
                  .mt-1{ data: { 'req-variable-container': '', 'variable-name': "#{base_name}[requirements_attributes][#{req_i}]" }, hidden: !rule.variable_requirement? }
                    - if rule.variable_requirement?
                      - variable_errors = req.errors[:variable]
                      - if rule.variable_label.present?
                        %label.form-label.mb-1= rule.variable_label
                      - case rule.variable_input_type
                      - when 'select'
                        %select.form-select.select2{ name: "#{base_name}[requirements_attributes][#{req_i}][variable]", class: ('is-invalid' if variable_errors.any?), data: { 'req-variable': '' } }
                          %option{value: ''} Select...
                          - rule.variable_options.each do |val, label|
                            %option{value: val, selected: val.to_s == req.variable.to_s}= label
                      - when 'multi-select'
                        - current_values = req.variable.to_s.split(',')
                        %select.form-select.select2{ multiple: true, class: ('is-invalid' if variable_errors.any?), data: { 'req-multi-display': '' } }
                          - rule.variable_options.each do |val, label|
                            %option{value: val, selected: current_values.include?(val.to_s)}= label
                        %input{type: 'hidden', name: "#{base_name}[requirements_attributes][#{req_i}][variable]", value: req.variable, data: { 'req-variable': '' }}
                      - when 'number'
                        %input.form-control{ type: 'number', name: "#{base_name}[requirements_attributes][#{req_i}][variable]", value: req.variable, placeholder: 'Value', class: ('is-invalid' if variable_errors.any?), data: { 'req-variable': '' }}
                      - else
                        %input.form-control{ type: 'text', name: "#{base_name}[requirements_attributes][#{req_i}][variable]", value: req.variable, placeholder: 'Value', class: ('is-invalid' if variable_errors.any?), data: { 'req-variable': '' }}
                      - if variable_errors.any?
                        .invalid-feedback.d-block= variable_errors.first
            %template{data: { 'req-template': '' }}
              .mb-2{data: { 'req-entry': '' }}
                .d-flex.gap-2.align-items-center
                  %select.form-select.w-auto.flex-shrink-0{ name: "#{base_name}[requirements_attributes][__REQ__][positive]" }
                    %option{value: 'true'} Must
                    %option{value: 'false'} Can't
                  %select.form-select.select2.flex-grow-1{ name: "#{base_name}[requirements_attributes][__REQ__][rule_id]", data: { 'req-rule-select': '' } }
                    %option{value: ''} Select rule...
                    - all_rules.each do |rule_opt|
                      - rule_opt_name = on_unit ? (rule_opt.alternate_name.presence || rule_opt.name_with_verb) : rule_opt.name_with_verb
                      %option{value: rule_opt.id, data: { variable: rule_opt.variable_requirement?.to_s, 'variable-type': rule_opt.variable_input_type.to_s, 'variable-options': rule_opt.variable_options.to_json, 'variable-label': rule_opt.variable_label.to_s }}= rule_opt_name
                  %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'requirements#removeReq' }} Remove
                .mt-1{ data: { 'req-variable-container': '', 'variable-name': "#{base_name}[requirements_attributes][__REQ__]" }, hidden: true }
            %button.btn.btn-sm.btn-outline-secondary.mt-2{type: 'button', data: { action: 'requirements#addReq' }} + Add Rule
