      shims = %W(
        child
        checkmark-circle
        clipboard-check
        clock
        individual
        step-back
        users
      )

    .style-guide__icon-list
      - icons.each_slice(4) do |slice|
        .row
          - slice.each do |icon|
            .col-sm-3.mb-6
              %i{ class: "icon-#{icon}" }
              %pre= ".icon-#{icon}"

    %h4.margin-bottom-03 Backwards-compatible Shim Names
    %p These names are preserved for existing templates. Prefer the canonical names above for new usage.
    .style-guide__icon-list
      - shims.each_slice(4) do |slice|
        .row
          - slice.each do |icon|
            .col-sm-3.mb-6
              %i{ class: "icon-#{icon}" }
              %pre= ".icon-#{icon}"
