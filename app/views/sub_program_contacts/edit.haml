= content_for :modal_title do
  Edit Contacts for #{@program.name}: #{@subprogram.name}

.row
  = render 'sub_programs/tab_navigation', active: 'contacts'
- if @program_contacts.errors.any?
  .errors
    = @program_contacts.errors.full_messages.join ","
%p
  The following contacts will be automatically added to any match involving #{@subprogram.name}.
.row
  .col-md-6.jContactFormWrapper
    = render 'form'


= render 'init_select2'
