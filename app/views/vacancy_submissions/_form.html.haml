- editing = vacancy_submission.persisted?
- initial_program = vacancy_submission.program_id || 0
- initial_sub = vacancy_submission.sub_program_id || 0
- stimulus_data = { controller: 'vacancy-submission-form', 'vacancy-submission-form-programs-value' => @programs_data.to_json, 'vacancy-submission-form-initial-program-value' => initial_program, 'vacancy-submission-form-initial-sub-program-value' => initial_sub }

= simple_form_for vacancy_submission, html: { id: 'vacancy_submission_form', data: stimulus_data } do |f|
  = f.error_notification

  %p.text-muted.small
    Fields marked with
    %span.text-danger *
    are required.

  / ── Section 1: Resource Type & Program ──
  .c-card.mb-4
    .c-card__content
      %h5.c-card__title Resource Type & Program

      = f.input :program_id, label: 'Program', as: :select2,
          collection: @programs.map { |p| [p.name, p.id] },
          include_blank: '-- Select a program --',
          required: true,
          input_html: { data: { 'vacancy-submission-form-target': 'programSelect' } }

      = f.input :sub_program_id, label: 'Sub-Program', as: :select2,
          collection: [],
          include_blank: false,
          input_html: { disabled: true, data: { 'vacancy-submission-form-target': 'subProgramSelect' } }

      .form-group
        %label.control-label Resource Type
        .form-control-plaintext.text-muted{style: 'min-height: 38px;', data: { 'vacancy-submission-form-target': 'resourceTypeDisplay' }}
          = vacancy_submission.resource_type.presence || '—'

  / ── Section 2: Unit Type ──
  .c-card.mb-4
    .c-card__content
      %h5.c-card__title Unit Type

      .form-group
        %label.control-label Unit Type
        .form-control-plaintext.text-muted{data: { 'vacancy-submission-form-target': 'unitTypeDisplay' }}
        %small.text-muted{data: { 'vacancy-submission-form-target': 'unitTypeHint' }}

      / Address fields — shown only for physical units
      %div{hidden: true, data: { 'vacancy-submission-form-target': 'addressFields' }}
        %hr
        %p.fw-semibold Unit Address

        = f.input :unit_address_street, label: 'Site Address', required: true, placeholder: 'Street Address'

        .row
          .col-md-6
            = f.input :unit_address_unit_number, label: 'Unit Number', placeholder: 'Number'
          .col-md-6
            = f.input :unit_address_city, label: 'City', required: true, placeholder: 'City'

        .row
          .col-md-6
            = f.input :unit_address_state, label: 'State', required: true
          .col-md-6
            = f.input :unit_address_zip, label: 'Zip Code', required: true, placeholder: '99999'

  / Actions
  .d-flex.gap-2
    = f.submit (editing ? 'Save Changes' : 'Submit Vacancy'), class: 'btn btn-primary'
    = link_to 'Cancel', (editing ? vacancy_submission_path(vacancy_submission) : vacancy_submissions_path), class: 'btn btn-outline-secondary'
