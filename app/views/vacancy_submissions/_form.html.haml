- editing = vacancy_submission.persisted?
- initial_program = vacancy_submission.program_id || 0
- initial_sub = vacancy_submission.sub_program_id || 0
- stimulus_data = { controller: 'vacancy-submission-form', 'vacancy-submission-form-programs-value' => @programs_data.to_json, 'vacancy-submission-form-initial-program-value' => initial_program, 'vacancy-submission-form-initial-sub-program-value' => initial_sub }

= form_with model: vacancy_submission, local: true, html: { id: 'vacancy_submission_form', data: stimulus_data } do |f|
  - if vacancy_submission.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - vacancy_submission.errors.full_messages.each do |msg|
          %li= msg

  %p.text-muted.small
    Fields marked with
    %span.text-danger *
    are required.

  / ── Section 1: Resource Type & Program ──
  .c-card.mb-4
    .c-card__content
      %h5.c-card__title Resource Type & Program

      .mb-3
        = label_tag :program_id, 'Program Name', class: 'form-label required'
        = f.select :program_id,
            options_for_select(@programs.map { |p| [p.name, p.id] }, vacancy_submission.program_id),
            { include_blank: '-- Select a program --' },
            class: 'form-select select2',
            data: { 'vacancy-submission-form-target': 'programSelect', action: 'change->vacancy-submission-form#onProgramChange' }

      .mb-3
        = label_tag :sub_program_id, 'Sub-Program Name', class: 'form-label required'
        = f.select :sub_program_id,
            options_for_select([]),
            { include_blank: '-- Select a sub-program --' },
            class: 'form-select select2',
            disabled: true,
            data: { 'vacancy-submission-form-target': 'subProgramSelect', action: 'change->vacancy-submission-form#onSubProgramChange' }

      .mb-3
        %label.form-label Resource Type
        .form-control-plaintext.text-muted{style: 'min-height: 38px;', data: { 'vacancy-submission-form-target': 'resourceTypeDisplay' }}
          = vacancy_submission.resource_type.presence || '—'

  / ── Section 2: Unit Type ──
  .c-card.mb-4
    .c-card__content
      %h5.c-card__title Unit Type

      .mb-3
        %label.form-label Unit Type
        / Populated by the vacancy-submission-form Stimulus controller based on sub-program selection
        .form-control-plaintext.text-muted{data: { 'vacancy-submission-form-target': 'unitTypeDisplay' }}
        %small.text-muted{data: { 'vacancy-submission-form-target': 'unitTypeHint' }}

      / Address fields — shown only for physical units
      %div{hidden: true, data: { 'vacancy-submission-form-target': 'addressFields' }}
        %hr
        %p.fw-semibold.mb-3 Unit Address

        .mb-3
          = label_tag :unit_address_street, 'Site Address', class: 'form-label required'
          = f.text_field :unit_address_street, class: 'form-control', placeholder: '123 Main St'

        .row.mb-3
          .col-md-6
            = label_tag :unit_address_unit_number, 'Unit Number', class: 'form-label'
            = f.text_field :unit_address_unit_number, class: 'form-control', placeholder: 'Apt 2B'
          .col-md-6
            = label_tag :unit_address_city, 'City', class: 'form-label required'
            = f.text_field :unit_address_city, class: 'form-control', placeholder: 'Boston'

        .row.mb-3
          .col-md-6
            = label_tag :unit_address_state, 'State', class: 'form-label required'
            = f.text_field :unit_address_state,
                value: vacancy_submission.unit_address_state.presence || 'MA',
                class: 'form-control'
          .col-md-6
            = label_tag :unit_address_zip, 'Zip Code', class: 'form-label required'
            = f.text_field :unit_address_zip, class: 'form-control', placeholder: '02101'

  / Actions
  .d-flex.gap-2
    = f.submit (editing ? 'Save Changes' : 'Submit Vacancy'), class: 'btn btn-primary'
    = link_to 'Cancel', (editing ? vacancy_submission_path(vacancy_submission) : vacancy_submissions_path), class: 'btn btn-outline-secondary'
