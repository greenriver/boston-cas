- editing     = vacancy_submission.persisted?
- form_url    = editing ? vacancy_submission_path(vacancy_submission) : vacancy_submissions_path
- form_method = editing ? :patch : :post
- dd          = editing ? vacancy_submission.draft_data : {}

= form_with url: form_url, method: form_method, local: true, html: {
    id: 'vacancy_submission_form',
    data: {
      controller: 'vacancy-submission-form',
      'vacancy-submission-form-programs-value': @programs_data.to_json,
      'vacancy-submission-form-initial-program-value': (dd['program_id'] || params.dig(:vacancy_submission, :program_id)).to_i,
      'vacancy-submission-form-initial-sub-program-value': (dd['sub_program_id'] || params.dig(:vacancy_submission, :sub_program_id)).to_i,
    }
  } do |f|
  - if vacancy_submission.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - vacancy_submission.errors.full_messages.each do |msg|
          %li= msg

  %p.text-muted.small
    Fields marked with
    %span.text-danger *
    are required.

  / ── Section 1: Resource Type & Program ──
  .card.mb-4
    .card-body
      %h5.card-title Resource Type & Program

      .mb-3
        = label_tag :program_id, 'Program Name', class: 'form-label required'
        = select_tag 'vacancy_submission[program_id]',
            options_for_select(@programs.map { |p| [p.name, p.id] }, dd['program_id'] || params.dig(:vacancy_submission, :program_id)),
            include_blank: '-- Select a program --',
            class: 'form-select select2',
            data: { 'vacancy-submission-form-target': 'programSelect', action: 'change->vacancy-submission-form#onProgramChange' }

      .mb-3
        = label_tag :sub_program_id, 'Sub-Program Name', class: 'form-label required'
        = select_tag 'vacancy_submission[sub_program_id]',
            options_for_select([]),
            include_blank: '-- Select a sub-program --',
            class: 'form-select select2',
            disabled: true,
            data: { 'vacancy-submission-form-target': 'subProgramSelect', action: 'change->vacancy-submission-form#onSubProgramChange' }

      .mb-3
        %label.form-label Resource Type
        .form-control-plaintext.text-muted{style: 'min-height: 38px;', data: { 'vacancy-submission-form-target': 'resourceTypeDisplay' }}
          = dd['resource_type'].presence || params.dig(:vacancy_submission, :resource_type).presence || '—'

  / ── Section 2: Unit Type ──
  .card.mb-4
    .card-body
      %h5.card-title Unit Type

      .mb-3
        %label.form-label Unit Type
        .form-control-plaintext.text-muted{data: { 'vacancy-submission-form-target': 'unitTypeDisplay' }}
        %small.text-muted{data: { 'vacancy-submission-form-target': 'unitTypeHint' }}

      / Address fields — shown only for physical units
      %div{hidden: true, data: { 'vacancy-submission-form-target': 'addressFields' }}
        %hr
        %p.fw-semibold.mb-3 Unit Address

        .mb-3
          = label_tag :unit_address_street, 'Site Address', class: 'form-label required'
          = text_field_tag 'vacancy_submission[unit_address_street]',
              dd['unit_address_street'] || params.dig(:vacancy_submission, :unit_address_street),
              class: 'form-control', placeholder: '123 Main St'

        .row.mb-3
          .col-md-6
            = label_tag :unit_address_unit_number, 'Unit Number', class: 'form-label'
            = text_field_tag 'vacancy_submission[unit_address_unit_number]',
                dd['unit_address_unit_number'] || params.dig(:vacancy_submission, :unit_address_unit_number),
                class: 'form-control', placeholder: 'Apt 2B'
          .col-md-6
            = label_tag :unit_address_city, 'City', class: 'form-label required'
            = text_field_tag 'vacancy_submission[unit_address_city]',
                dd['unit_address_city'] || params.dig(:vacancy_submission, :unit_address_city),
                class: 'form-control', placeholder: 'Boston'

        .row.mb-3
          .col-md-6
            = label_tag :unit_address_state, 'State', class: 'form-label required'
            = text_field_tag 'vacancy_submission[unit_address_state]',
                dd['unit_address_state'] || params.dig(:vacancy_submission, :unit_address_state).presence || 'MA',
                class: 'form-control'
          .col-md-6
            = label_tag :unit_address_zip, 'Zip Code', class: 'form-label required'
            = text_field_tag 'vacancy_submission[unit_address_zip]',
                dd['unit_address_zip'] || params.dig(:vacancy_submission, :unit_address_zip),
                class: 'form-control', placeholder: '02101'

  / Actions
  .d-flex.gap-2
    = submit_tag(editing ? 'Save Changes' : 'Submit Vacancy', class: 'btn btn-primary')
    = link_to 'Cancel', (editing ? vacancy_submission_path(vacancy_submission) : vacancy_submissions_path), class: 'btn btn-outline-secondary'
