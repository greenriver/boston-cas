- readonly = local_assigns.fetch(:readonly, false)
- default_building_id = local_assigns.fetch(:default_building_id, nil)
- confidential = local_assigns.fetch(:confidential, false)
- if readonly
  - building = Building.find_by(id: unit['building_id'])
  %dl.row.g-2.mb-3
    .col-sm-6
      %dt.vs-field-label Building
      %dd.vs-field-value.mb-0
        - if building
          = building.name
          %br/
          = building.building_address.join(', ').presence || '—'
        - else
          = '—'
    .col-sm-6
      %dt.vs-field-label Unit Number
      %dd.vs-field-value.mb-0= unit['unit_number'].presence || '—'
- else
  - selected_building_id = unit['building_id'].presence || default_building_id
  %fieldset.mb-4{data: { controller: 'vacancy-unit-building' }}
    %legend
      Unit Address
    .mb-3
      %label.form-label.fw-semibold
        Building
        %abbr{title: 'required'} *
      %select.form-select.select2{ name: "vacancy_submission[units][#{index}][building_id]", required: true, style: 'width: 100%;', data: { 'vacancy-unit-building-target': 'select', action: 'change->vacancy-unit-building#render' } }
        %option{value: ''} Select a building…
        = vacancy_building_select_options(selected_building_id)
      .mt-2.small{data: { 'vacancy-unit-building-target': 'display' }, hidden: true}
    .mb-3
      - if confidential
        .alert.alert-warning.py-2.small
          This program is confidential, do not enter a real address as the unit number
      %label.form-label
        Unit Number
        %abbr{title: 'required'} *
      %input.form-control{ name: "vacancy_submission[units][#{index}][unit_number]", value: unit['unit_number'], placeholder: 'Number', required: true }
