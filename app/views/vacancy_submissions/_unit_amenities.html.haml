- readonly = local_assigns.fetch(:readonly, false)
- if readonly
  - checked = Array(unit['amenities']).select(&:present?)
  - if checked.any?
    %dl.g-2.mb-3
      %dt.vs-field-label Amenities
      %dd.vs-field-value.mb-2= checked.join(', ')
- else
  - if amenity_names.any?
    %fieldset.mb-4
      %legend Amenities
      .d-flex.flex-wrap.gap-3
        - amenity_names.each do |amenity|
          .form-check
            %input.form-check-input{ type: 'checkbox', name: "vacancy_submission[units][#{index}][amenities][]", value: amenity, id: "unit_#{index}_amenity_#{amenity.parameterize}", checked: Array(unit['amenities']).include?(amenity) }
            %label.form-check-label{ for: "unit_#{index}_amenity_#{amenity.parameterize}" }= amenity
