- readonly = local_assigns.fetch(:readonly, false)
- amenity_names = local_assigns.fetch(:amenity_names, [])
- attr_catalog = local_assigns.fetch(:attr_catalog, {})
- attr_names = local_assigns.fetch(:attr_names, [])
- all_rules = local_assigns.fetch(:all_rules, [])
.c-card.mb-2{data: (readonly ? {} : { 'unit-entry': '' })}
  .c-card__header
    %h2{data: (readonly ? {} : { 'unit-card-title': '' })}= "Unit #{number}"
  .c-card__content
    = render 'vacancy_submissions/unit_address', unit: unit, index: index, readonly: readonly
    = render 'vacancy_submissions/unit_details', unit: unit, index: index, readonly: readonly
    = render 'vacancy_submissions/unit_amenities', unit: unit, index: index, amenity_names: amenity_names, readonly: readonly
    = render 'vacancy_submissions/unit_attributes', unit: unit, index: index, attr_catalog: attr_catalog, attr_names: attr_names, readonly: readonly
    = render 'vacancy_submissions/unit_media_links', unit: unit, index: index, readonly: readonly
    = render 'vacancy_submissions/unit_requirements',
      unit: unit,
      index: index,
      on_unit: true,
      all_rules: all_rules,
      readonly: readonly
  - unless readonly
    .d-flex.justify-content-end.mt-2
      %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'vacancy-units#removeUnit' }} Remove
