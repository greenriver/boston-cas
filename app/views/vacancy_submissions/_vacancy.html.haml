- unit_list = Array(vacancy_submission.units).presence || [{}]
%div{data: { controller: 'vacancy-units', 'vacancy-units-is-voucher-value': is_voucher }}
  %div{data: { 'vacancy-units-target': 'list' }}
    - unit_list.each_with_index do |unit, i|
      .border.rounded.p-3.mb-3{data: { 'unit-entry': '' }}
        - if is_voucher
          .d-flex.align-items-center.justify-content-between
            %p.fw-semibold.mb-0{data: { 'voucher-label': '' }}= "Voucher #{i + 1}"
            %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'vacancy-units#removeUnit' }} Remove
          %input{type: 'hidden', name: "vacancy_submission[units][#{i}][name]", value: "Voucher #{i + 1}", data: { 'voucher-name': '' }}
        - else
          .mb-3
            %label.form-label.fw-semibold
              Site Address
              %abbr{title: 'required'} *
            %input.form-control{
              name: "vacancy_submission[units][#{i}][street]",
              value: unit['street'],
              placeholder: 'Street Address',
              required: true
            }
          .row.mb-3
            .col-md-6
              %label.form-label Unit Number
              %input.form-control{
                name: "vacancy_submission[units][#{i}][unit_number]",
                value: unit['unit_number'],
                placeholder: 'Number'
              }
            .col-md-6
              %label.form-label
                City
                %abbr{title: 'required'} *
              %input.form-control{
                name: "vacancy_submission[units][#{i}][city]",
                value: unit['city'],
                placeholder: 'City',
                required: true
              }
          .row.mb-3
            .col-md-6
              %label.form-label
                State
                %abbr{title: 'required'} *
              %input.form-control{
                name: "vacancy_submission[units][#{i}][state]",
                value: unit['state'],
                required: true
              }
            .col-md-6
              %label.form-label
                Zip Code
                %abbr{title: 'required'} *
              %input.form-control{
                name: "vacancy_submission[units][#{i}][zip]",
                value: unit['zip'],
                placeholder: '99999',
                required: true
              }
          .d-flex.justify-content-end.mt-2
            %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'vacancy-units#removeUnit' }} Remove

  %template{data: { 'unit-template': '' }}
    %div.border.rounded.p-3.mb-3{data: { 'unit-entry': '' }}
      - if is_voucher
        .d-flex.align-items-center.justify-content-between
          %p.fw-semibold.mb-0{data: { 'voucher-label': '' }} Voucher __NUMBER__
          %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'vacancy-units#removeUnit' }} Remove
        %input{type: 'hidden', name: 'vacancy_submission[units][__INDEX__][name]', value: 'Voucher __NUMBER__', data: { 'voucher-name': '' }}
      - else
        .mb-3
          %label.form-label.fw-semibold
            Site Address
            %abbr{title: 'required'} *
          %input.form-control{name: 'vacancy_submission[units][__INDEX__][street]', placeholder: 'Street Address', required: true}
        .row.mb-3
          .col-md-6
            %label.form-label Unit Number
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][unit_number]', placeholder: 'Number'}
          .col-md-6
            %label.form-label
              City
              %abbr{title: 'required'} *
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][city]', placeholder: 'City', required: true}
        .row.mb-3
          .col-md-6
            %label.form-label
              State
              %abbr{title: 'required'} *
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][state]', required: true}
          .col-md-6
            %label.form-label
              Zip Code
              %abbr{title: 'required'} *
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][zip]', placeholder: '99999', required: true}
        .d-flex.justify-content-end.mt-2
          %button.btn.btn-sm.btn-outline-danger{type: 'button', data: { action: 'vacancy-units#removeUnit' }} Remove

  %button.btn.btn-outline-secondary.mt-2{
    type: 'button',
    data: { action: 'vacancy-units#addUnit' }
  }
    = is_voucher ? '+ Add another voucher' : '+ Add another unit'
