- unit_list = Array(vacancy_submission.units).presence || [{}]
%div{data: { controller: 'vacancy-units' }}
  %div{data: { 'vacancy-units-target': 'list' }}
    - unit_list.each_with_index do |unit, i|
      %div.border.rounded.p-3.mb-3{data: { 'unit-entry': '' }}
        - if is_voucher
          .mb-3
            %label.form-label.fw-semibold.required Voucher ID or label
            %input.form-control{
              name: "vacancy_submission[units][#{i}][name]",
              value: unit['name'],
              placeholder: 'e.g. Section 8 #1234',
              required: true
            }
        - else
          .mb-3
            %label.form-label.fw-semibold.required Site Address
            %input.form-control{
              name: "vacancy_submission[units][#{i}][street]",
              value: unit['street'],
              placeholder: 'Street Address',
              required: true
            }
          .row.mb-3
            .col-md-6
              %label.form-label Unit Number
              %input.form-control{
                name: "vacancy_submission[units][#{i}][unit_number]",
                value: unit['unit_number'],
                placeholder: 'Number'
              }
            .col-md-6
              %label.form-label.required City
              %input.form-control{
                name: "vacancy_submission[units][#{i}][city]",
                value: unit['city'],
                placeholder: 'City',
                required: true
              }
          .row.mb-3
            .col-md-6
              %label.form-label.required State
              %input.form-control{
                name: "vacancy_submission[units][#{i}][state]",
                value: unit['state'],
                required: true
              }
            .col-md-6
              %label.form-label.required Zip Code
              %input.form-control{
                name: "vacancy_submission[units][#{i}][zip]",
                value: unit['zip'],
                placeholder: '99999',
                required: true
              }
        %button.btn.btn-sm.btn-outline-danger.mt-1{
          type: 'button',
          data: { action: 'vacancy-units#removeUnit' }
        } Remove

  %template{data: { 'unit-template': '' }}
    %div.border.rounded.p-3.mb-3{data: { 'unit-entry': '' }}
      - if is_voucher
        .mb-3
          %label.form-label.fw-semibold.required Voucher ID or label
          %input.form-control{
            name: 'vacancy_submission[units][__INDEX__][name]',
            placeholder: 'e.g. Section 8 #1234',
            required: true
          }
      - else
        .mb-3
          %label.form-label.fw-semibold.required Site Address
          %input.form-control{name: 'vacancy_submission[units][__INDEX__][street]', placeholder: 'Street Address', required: true}
        .row.mb-3
          .col-md-6
            %label.form-label Unit Number
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][unit_number]', placeholder: 'Number'}
          .col-md-6
            %label.form-label.required City
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][city]', placeholder: 'City', required: true}
        .row.mb-3
          .col-md-6
            %label.form-label.required State
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][state]', required: true}
          .col-md-6
            %label.form-label.required Zip Code
            %input.form-control{name: 'vacancy_submission[units][__INDEX__][zip]', placeholder: '99999', required: true}
      %button.btn.btn-sm.btn-outline-danger.mt-1{
        type: 'button',
        data: { action: 'vacancy-units#removeUnit' }
      } Remove

  %button.btn.btn-outline-secondary.mt-2{
    type: 'button',
    data: { action: 'vacancy-units#addUnit' }
  }
    = is_voucher ? '+ Add another voucher' : '+ Add another unit'
