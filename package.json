{
  "name": "boston-cas",
  "version": "1.0.0",
  "_comment": "NOTE: not all packages are managed here, many are checked into source at /vendor/assets or /app/assets/javascripts/",
  "dependencies": {
    "@eonasdan/tempus-dominus": "^6.9.4",
    "@hotwired/stimulus": "^3.2.2",
    "@popperjs/core": "^2.11.8",
    "billboard.js": "^3.18.0",
    "bootstrap": "^5.3.3",
    "d3": "^7.6.1",
    "select2-bootstrap-5-theme": "^1.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28",
    "yarn-deduplicate": "^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenriver/boston-cas.git"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds --public-path=/assets",
    "build:production": "esbuild app/javascript/application.js --bundle --sourcemap --minify --outdir=app/assets/builds --public-path=/assets",
    "dedup": "yarn-deduplicate -s fewer yarn.lock"
  }
}
